# Host-owned non-secret force-loop defaults (strict KEY=VALUE; no shell source).
# Secrets must NOT live here. Set AAS_COMPUTE_SECRETS_FILE and
# AAS_PROVIDER_SECRETS_FILE only in the launcher process.
AAS_AUTOLOOP_GOAL_PRIORITY=on
AAS_AUTOLOOP_NOTIFY=auto
AAS_AUTOLOOP_FORMAL_POLICY=on
AAS_AUTOLOOP_FORMAL_TYPECHECK=1
