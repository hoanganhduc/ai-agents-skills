{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "public-source.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tex_policy",
    "job_id",
    "source_root",
    "destination",
    "public_origin",
    "files",
    "publication_enabled"
  ],
  "properties": {
    "schema_version": {
      "const": "public-source.v1"
    },
    "tex_policy": {
      "const": "tex-comments.v1"
    },
    "job_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "source_root": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "destination": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "public_origin": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "selected file",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "target",
          "transform",
          "reason",
          "provenance",
          "source_sha256",
          "output_sha256",
          "bytes",
          "executable"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "transform": {
            "enum": [
              "copy",
              "tex"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "provenance": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "output_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "executable": {
            "type": "boolean"
          },
          "keep_comment_lines": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "publication_enabled": {
      "const": false
    },
    "approval": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "selection attestation",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer",
        "selection_digest"
      ],
      "properties": {
        "reviewer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "selection_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
