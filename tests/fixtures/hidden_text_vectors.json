    {"name": "CRLF", "text": "a\r\nb", "packet_hidden": [], "framed": ["| a", "| b"], "removed": 0},
    {"name": "line tabulation U+000B", "text": "a\u000bb", "packet_hidden": [1], "framed": ["| a", "| b"], "removed": 0},
    {"name": "form feed U+000C", "text": "a\fb", "packet_hidden": [1], "framed": ["| a", "| b"], "removed": 0},
    {"name": "file separator U+001C", "text": "a\u001cb", "packet_hidden": [1], "framed": ["| a", "| b"], "removed": 0},
    {"name": "next line U+0085", "text": "a\u0085b", "packet_hidden": [1], "framed": ["| a", "| b"], "removed": 0},
    {"name": "line separator U+2028", "text": "a\u2028b", "packet_hidden": [], "framed": ["| a", "| b"], "removed": 0},
    {"name": "paragraph separator U+2029", "text": "a\u2029b", "packet_hidden": [], "framed": ["| a", "| b"], "removed": 0},
    {"name": "tab", "text": "a\tb", "packet_hidden": [], "framed": ["| a\tb"], "removed": 0},
    {"name": "blank line", "text": "a\n\nb", "packet_hidden": [], "framed": ["| a", "| ", "| b"], "removed": 0},
    {"name": "trailing line feed", "text": "a\n", "packet_hidden": [], "framed": ["| a"], "removed": 0},
    {"name": "NUL U+0000", "text": "a\u0000b", "packet_hidden": [1], "framed": ["| ab"], "removed": 1},
    {"name": "right-to-left override U+202E", "text": "a\u202eb", "packet_hidden": [1], "framed": ["| ab"], "removed": 1},
    {"name": "zero-width space U+200B inside a key name", "text": "exe\u200bcute", "packet_hidden": [3], "framed": ["| execute"], "removed": 1},
