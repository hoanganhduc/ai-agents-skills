    {"name": "unassigned tag U+E0000", "text": "\udb40\udc00a", "packet_hidden": [0], "framed": ["| a"], "removed": 1},
    {"name": "lone surrogate U+D800", "text": "a\ud800b", "packet_hidden": [1], "framed": ["| ab"], "removed": 1},
    {"name": "supplementary variation selector U+E0100 after a letter", "text": "a\udb40\udd00", "packet_hidden": [1], "framed": ["| a"], "removed": 1},
