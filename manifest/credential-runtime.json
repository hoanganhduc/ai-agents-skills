{
  "schema_version": 1,
  "runtime_trust": {
    "model": "owner-controlled",
    "predicates": [
      {
        "component": "launcher, loader, broker, wrappers, drivers and broker modules",
        "owner": "root or current uid",
        "mode": "no group/other write",
        "type": "regular, not symlink",
        "link_rule": "single link unless root-owned"
      },
      {
        "component": "embedded secure loaders",
        "owner": "root or effective uid",
        "mode": "no group/other write",
        "type": "regular",
        "link_rule": "single link unconditionally"
      },
      {
        "component": "OpenClaw executable attestation",
        "owner": "root or effective uid",
        "mode": "no group/other write; executable",
        "type": "regular",
        "link_rule": "single link unconditionally"
      },
      {
        "component": "provider host binaries",
        "owner": "root or current uid",
        "mode": "no group/other write; executable",
        "type": "regular, not symlink",
        "link_rule": "no link-count restriction"
      },
      {
        "component": "runtime and venv directories; lease parents",
        "owner": "root or current uid",
        "mode": "no group/other write",
        "type": "directory, not symlink",
        "link_rule": "not applicable"
      },
      {
        "component": "ancestors outside runtime or venv",
        "owner": "root or current uid, or root-owned sticky",
        "mode": "no group/other write except root-owned sticky ancestors",
        "type": "directory, not symlink",
        "link_rule": "not applicable"
      },
      {
        "component": "distro binaries",
        "owner": "root or current uid",
        "mode": "no group/other write",
        "type": "regular",
        "link_rule": "checking component determines the link rule"
      },
      {
        "component": "reaper lease",
        "owner": "current uid",
        "mode": "exactly 0600",
        "type": "regular, not symlink",
        "link_rule": "single link"
      }
    ],
    "launcher_check": "The launcher and chain to the runtime root are owner-controlled; its workspace is inside that runtime. Source checkout runners/ and installed root/run_skill.sh layouts are accepted. External ancestors must be owner-controlled or root-owned sticky directories.",
    "accepts": [
      "installed runtime root",
      "source checkout runners/ layout"
    ],
    "refuses": [
      "group/other-writable launcher or ancestor",
      "symlinked launcher",
      "hard-linked non-root launcher",
      "foreign-owner launcher",
      "workspace outside the runtime"
    ],
    "does_not_defend_against": "A process running as the same uid: the retired gate ran only a launcher the user could not write (a root-owned copy under a root-owned path), so a same-uid process could not alter launcher content, but it could already read every secret file the pointer variables name and run the same programs directly. The new rule runs a user-writable launcher, so a same-uid process can alter it. Ownership and mode are pinned; content is not. Installer verify digests are the only advisory content check."
  },
  "skill_python": {
    "venv": "~/.agents_skills_venv",
    "override_env": "AAS_SKILL_VENV",
    "exported_env": "AAS_RUNTIME_PYTHON_PREFIX",
    "admission": "The prefix is an absolute canonical non-symlink directory built from the attested system Python. Its directory chain, regular pyvenv.cfg, and startup files are owner-controlled; only external root-owned sticky ancestors are excepted. The pyvenv.cfg home, version and include-system-site-packages keys occur exactly once and match the attested Python with system site packages disabled. bin, lib and site-packages are non-symlink directories. bin/python and every present versioned python alias are symlinks to that attested interpreter. Admission checks startup files; verify-skill-python checks every file.",
    "inadmissible": "refused (exit 127)",
    "absent": "system Python",
    "adopting_skills": [
      "zotero",
      "calibre",
      "docling",
      "research-digest-wrapper",
      "lean-explore-mcp",
      "modal-research-compute",
      "kaggle-research-compute",
      "hetzner-research-compute"
    ]
  },
  "consumers": [
    {
      "commands": ["skills/axiom-axle-mcp/run_axiom_axle_mcp.sh"],
      "authority": "AAS_SKILL_SECRETS_FILE",
      "projection": ["AXLE_API_KEY"]
    },
    {
      "commands": ["skills/lean-explore-mcp/run_lean_explore_mcp.sh"],
      "authority": "AAS_SKILL_SECRETS_FILE",
      "projection": ["LEANEXPLORE_API_KEY"]
    },
    {
      "commands": ["skills/docling/run_docling.sh"],
      "authority": "AAS_SKILL_SECRETS_FILE",
      "projection": ["OCR_SPACE_API_KEY", "OCR_SPACE_KEY", "OCRSPACE_API_KEY", "OCRSPACE_KEY"]
    },
    {
      "commands": ["skills/research-digest-wrapper/run_research_digest.sh"],
      "authority": "AAS_SKILL_SECRETS_FILE",
      "projection": ["OPENCLAW_S2_API_KEY"]
    },
    {
      "commands": ["skills/submission-venue-selector/run_submission_venue_selector.sh"],
      "authority": "AAS_SKILL_SECRETS_FILE",
      "projection": ["SEMANTIC_SCHOLAR_API_KEY", "UNPAYWALL_EMAIL"]
    },
    {
      "commands": ["skills/lean-research-library/run_lean_research_library.sh"],
      "authority": "AAS_SKILL_SECRETS_FILE",
      "projection": ["ZENODO_TOKEN"]
    },
    {
      "commands": ["skills/zotero/run_zot.sh"],
      "authority": "AAS_ZOTERO_SECRETS_FILE",
      "projection": ["ZOTERO_API_KEY", "WEBDAV_PASSWORD", "GDRIVE_CREDENTIALS", "SEMANTIC_SCHOLAR_API_KEY"]
    },
    {
      "commands": ["skills/calibre/run_cal.sh"],
      "authority": "AAS_CALIBRE_SECRETS_FILE",
      "projection": ["GDRIVE_CREDENTIALS", "CALIBRE_GDRIVE_FOLDER_ID"]
    },
    {
      "commands": ["skills/send-email/run_send_email.sh", "skills/send-email/send_email.py"],
      "authority": "SEND_EMAIL_SECRETS_FILE",
      "projection": "consumer-validated-structured-file"
    },
    {
      "commands": ["skills/remote-bridge/run_remote_bridge.sh", "skills/remote-bridge/remote_bridge.py", "skills/remote-bridge/dispatch_aas.py"],
      "authority": "REMOTE_BRIDGE_SECRETS_FILE",
      "projection": "consumer-validated-structured-file"
    },
    {
      "commands": ["skills/vnthuquan/run_vnthuquan.sh", "skills/vnthuquan/vnthuquan_wrapper.py"],
      "authority": "AAS_CALIBRE_SECRETS_FILE",
      "projection": "consumer-validated-structured-file"
    },
    {
      "commands": ["skills/zotero/send_file.sh", "skills/zotero/send_telegram.sh", "skills/zotero/send_queue_worker.sh", "skills/zotero/send_queue.py"],
      "authority": "AAS_FILE_DELIVERY_SECRETS_FILE",
      "projection": "consumer-validated-delivery-authority"
    },
    {
      "commands": ["skills/modal-research-compute/run_modal_research_compute.sh"],
      "authority": "~/.modal.toml",
      "projection": ["MODAL_TOKEN_ID", "MODAL_TOKEN_SECRET"]
    },
    {
      "commands": ["skills/kaggle-research-compute/run_kaggle_research_compute.sh"],
      "authority": ["~/.kaggle/access_token", "AAS_COMPUTE_SECRETS_FILE"],
      "projection": ["KAGGLE_API_TOKEN"]
    },
    {
      "commands": ["skills/hetzner-research-compute/run_hetzner_research_compute.sh", "skills/hetzner-research-compute/run_hetzner_reaper.sh"],
      "authority": "AAS_COMPUTE_SECRETS_FILE",
      "projection": ["HCLOUD_TOKEN"]
    },
    {
      "commands": ["skills/autonomous-research-loop-runtime/run_autonomous_research_loop.sh", "skills/autonomous-research-loop-runtime/force-loop/run_force_loop.sh"],
      "authority": ["AAS_PROVIDER_SECRETS_FILE", "AAS_COMPUTE_SECRETS_FILE"],
      "projection": "arl-credential-broker"
    }
  ],
  "fallback": {
    "authority": "AAS_SKILL_SECRETS_FILE",
    "projection": [],
    "behavior": "reject-nonempty-unmapped-authority"
  }
}
